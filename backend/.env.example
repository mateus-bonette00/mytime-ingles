# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mytime_ingles
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key
COURSE_PRICE=29.90
# URL publica do webhook (ex: https://abc123.ngrok-free.app/api/payments/webhook)
# Em dev: usar ngrok ou localtunnel. Em prod: URL real do backend
WEBHOOK_URL=

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="MyTime Inglês <noreply@mytimeingles.com>"

# Frontend URL
FRONTEND_URL=http://localhost:5173

# File Storage (Google Drive or DigitalOcean Spaces)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# For Google Drive:
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REDIRECT_URI=
# GOOGLE_DRIVE_REFRESH_TOKEN=

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
